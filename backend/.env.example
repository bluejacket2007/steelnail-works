# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://nailfactory:nailfactory_dev_only@localhost:5432/nailfactory
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
AUTO_CREATE_TABLES=true

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:nailfactory_dev_only@localhost:6379/0

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Field-level encryption (Fernet) ──────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated list; first key encrypts, all keys decrypt (rotation support).
FERNET_KEYS=CHANGE_ME_generate_a_fernet_key

# ── Network security ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
ENFORCE_HTTPS=false
RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=200
# Interactive Swagger UI at /docs — leave on for local dev, set to false in
# any real deployment (see render.yaml).
EXPOSE_API_DOCS=true

# ── Payments ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
DEFAULT_CURRENCY=INR

# ── AI Agent (Anthropic) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-opus-4-8
AGENT_SESSION_TTL_SECONDS=86400
AGENT_MAX_TOOL_ITERATIONS=10

# ── Costing / margin guardrails ──────────────────────────────────────────────
RAW_WIRE_ROD_COST_PER_KG=62.0
PROCESSING_OVERHEAD_PER_KG=18.0
NET_MARGIN_FLOOR=0.12
