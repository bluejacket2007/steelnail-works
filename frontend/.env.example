# Server-side: where the Next.js dev/prod server proxies /api/* to (see next.config.mjs).
# Not needed in the browser — only read in Server Components and the rewrite config.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Stripe Elements — publishable key only (safe to expose to the browser).
# Get this from the Stripe Dashboard > Developers > API keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Razorpay Checkout — key_id only (safe to expose to the browser; the secret
# stays server-side in backend/.env as RAZORPAY_KEY_SECRET).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
